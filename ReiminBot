import os
import datetime
import pytz
from telegram import Update
from telegram.ext import ApplicationBuilder, ContextTypes, CommandHandler

# Token akan otomatis dibaca dari server, atau masukkan langsung di sini
TOKEN = os.getenv("TOKEN", "@MyReimin_Bot")

catatan_harian = []

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text(
        "Halo! @MyReimin_Bot aktif.\n\n"
        "Fitur Perintah:\n"
        "• /catat [isi] - Tambah catatan\n"
        "• /lihat - Lihat daftar catatan\n"
        "• /hapus [nomor] - Hapus catatan\n"
        "• /setjam [HH:MM] - Atur jam pengingat harian (Contoh: /setjam 08:00)"
    )

async def tambah_catatan(update: Update, context: ContextTypes.DEFAULT_TYPE):
    text_masuk = " ".join(context.args)
    if not text_masuk:
        await update.message.reply_text("Format salah. Contoh: /catat Beli token listrik")
        return
    
    catatan_harian.append(text_masuk)
    await update.message.reply_text(f"✅ Catatan ditambahkan! (Total: {len(catatan_harian)})")

async def lihat_catatan(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if not catatan_harian:
        await update.message.reply_text("📌 Belum ada catatan tersimpan.")
        return
    
    pesan = "📋 *Daftar Catatan Anda:*\n"
    for i, catatan in enumerate(catatan_harian, 1):
        pesan += f"{i}. {catatan}\n"
    await update.message.reply_text(pesan, parse_mode="Markdown")

async def hapus_catatan(update: Update, context: ContextTypes.DEFAULT_TYPE):
    try:
        nomor = int(context.args[0])
        if 1 <= nomor <= len(catatan_harian):
            dihapus = catatan_harian.pop(nomor - 1)
            await update.message.reply_text(f"🗑️ Catatan berhasil dihapus: \"{dihapus}\"")
        else:
            await update.message.reply_text("⚠️ Nomor catatan tidak ditemukan.")
    except (IndexError, ValueError):
        await update.message.reply_text("Format salah. Contoh: /hapus 1")

async def kirim_pengingat_harian(context: ContextTypes.DEFAULT_TYPE):
    job = context.job
    if not catatan_harian:
        await context.bot.send_message(chat_id=job.chat_id, text="🔔 *Pengingat Harian:* Belum ada catatan tersimpan hari ini.", parse_mode="Markdown")
    else:
        pesan = "🔔 *PENGINGAT CATATAN HARIAN:* \n\n"
        for i, catatan in enumerate(catatan_harian, 1):
            pesan += f"{i}. {catatan}\n"
        await context.bot.send_message(chat_id=job.chat_id, text=pesan, parse_mode="Markdown")

async def set_jam_pengingat(update: Update, context: ContextTypes.DEFAULT_TYPE):
    try:
        waktu_str = context.args[0]
        jam, menit = map(int, waktu_str.split(":"))
        
        current_jobs = context.job_queue.get_jobs_by_name(str(update.effective_chat.id))
        for job in current_jobs:
            job.schedule_removal()

        tz = pytz.timezone('Asia/Jakarta')
        waktu_target = datetime.time(hour=jam, minute=menit, tzinfo=tz)
        
        context.job_queue.run_daily(
            kirim_pengingat_harian,
            time=waktu_target,
            chat_id=update.effective_chat.id,
            name=str(update.effective_chat.id)
        )
        
        await update.message.reply_text(f"⏰ Pengingat harian berhasil diatur setiap pukul {waktu_str} WIB.")
    except Exception:
        await update.message.reply_text("Format jam salah. Gunakan format 24-jam (Contoh: /setjam 07:30)")

if __name__ == '__main__':
    app = ApplicationBuilder().token(TOKEN).build()

    app.add_handler(CommandHandler("start", start))
    app.add_handler(CommandHandler("catat", tambah_catatan))
    app.add_handler(CommandHandler("lihat", lihat_catatan))
    app.add_handler(CommandHandler("hapus", hapus_catatan))
    app.add_handler(CommandHandler("setjam", set_jam_pengingat))

    print("Bot @MyReimin_Bot aktif...")
    app.run_polling()
